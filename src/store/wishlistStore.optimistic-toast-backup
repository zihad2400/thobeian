import { create } from "zustand";
import axios from "axios";
import toast from "@/lib/toast";

export const useWishlistStore = create((set, get) => ({
  items: [],
  loading: false,
  initialized: false,

  fetchWishlist: async () => {
    try {
      set({ loading: true });

      const { data } = await axios.get("/api/wishlist");

      set({
        items: data.data.products || [],
        initialized: true,
      });
    } catch (error) {
      console.error("Wishlist fetch error:", error);

      set({
        items: [],
        initialized: true,
      });
    } finally {
      set({ loading: false });
    }
  },

  toggleWishlist: async (productId) => {
    const previousItems = get().items;

    const exists = previousItems.some((item) => {
      const id =
        typeof item === "string"
          ? item
          : item?._id;

      return id?.toString() === productId?.toString();
    });

    // INSTANT UI UPDATE
    const optimisticItems = exists
      ? previousItems.filter((item) => {
          const id =
            typeof item === "string"
              ? item
              : item?._id;

          return id?.toString() !== productId?.toString();
        })
      : [
          ...previousItems,
          {
            _id: productId,
          },
        ];

    set({
      items: optimisticItems,
      initialized: true,
      loading: true,
    });

    try {
      const { data } = await axios.post(
        "/api/wishlist",
        {
          productId,
        }
      );

      // Sync with real server data
      set({
        items: data.data.products || [],
        initialized: true,
        loading: false,
      });

      toast.success(data.message);

      return true;
    } catch (error) {
      console.error("Wishlist toggle error:", error);

      // ROLLBACK if server fails
      set({
        items: previousItems,
        loading: false,
      });

      toast.error(
        error.response?.data?.message ||
          "Failed to update wishlist"
      );

      return false;
    }
  },

  isInWishlist: (productId) => {
    return get().items.some((item) => {
      const id =
        typeof item === "string"
          ? item
          : item?._id;

      return id?.toString() === productId?.toString();
    });
  },

  clearWishlist: () => {
    set({
      items: [],
      initialized: true,
    });
  },
}));
