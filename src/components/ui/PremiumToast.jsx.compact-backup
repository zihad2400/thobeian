"use client";

import {
  CheckCircle2,
  XCircle,
  AlertTriangle,
  Info,
  X,
} from "lucide-react";
import hotToast from "react-hot-toast";

const TOAST_CONFIG = {
  success: {
    icon: CheckCircle2,
    label: "SUCCESS",
    accent: "#C8A96B",
    iconBg: "rgba(200, 169, 107, 0.12)",
    iconColor: "#B99555",
    duration: 4200,
  },

  error: {
    icon: XCircle,
    label: "ERROR",
    accent: "#B85C5C",
    iconBg: "rgba(184, 92, 92, 0.10)",
    iconColor: "#A84F4F",
    duration: 5000,
  },

  warning: {
    icon: AlertTriangle,
    label: "WARNING",
    accent: "#C9963E",
    iconBg: "rgba(201, 150, 62, 0.10)",
    iconColor: "#B27D2E",
    duration: 4200,
  },

  info: {
    icon: Info,
    label: "NOTICE",
    accent: "#8D806D",
    iconBg: "rgba(141, 128, 109, 0.10)",
    iconColor: "#776B5B",
    duration: 4200,
  },
};

export default function PremiumToast({
  t,
  type = "success",
  message,
  title,
}) {
  const config = TOAST_CONFIG[type] || TOAST_CONFIG.info;
  const Icon = config.icon;

  const dismiss = () => {
    hotToast.dismiss(t.id);
  };

  return (
    <div
      role="status"
      aria-live="polite"
      className={`
        thobeian-toast
        relative
        w-full
        overflow-hidden
        rounded-[18px]
        border
        bg-white/95
        backdrop-blur-xl
        transition-all
        duration-500
        ease-[cubic-bezier(0.22,1,0.36,1)]
        ${
          t.visible
            ? "translate-x-0 scale-100 opacity-100"
            : "translate-x-8 scale-[0.97] opacity-0"
        }
      `}
      style={{
        borderColor: `${config.accent}38`,
        boxShadow: `
          0 20px 60px rgba(31,31,31,0.12),
          0 4px 18px rgba(31,31,31,0.06)
        `,
      }}
    >
      {/* Luxury top accent */}
      <div
        className="absolute left-0 right-0 top-0 h-[2px]"
        style={{
          background: `
            linear-gradient(
              90deg,
              transparent 0%,
              ${config.accent} 25%,
              ${config.accent} 75%,
              transparent 100%
            )
          `,
        }}
      />

      {/* Soft ambient glow */}
      <div
        className="pointer-events-none absolute -right-8 -top-8 h-24 w-24 rounded-full opacity-[0.08] blur-2xl"
        style={{
          backgroundColor: config.accent,
        }}
      />

      {/* Main content */}
      <div className="relative flex items-start gap-3.5 px-4 pb-3.5 pt-4 sm:px-4.5">

        {/* Animated icon */}
        <div
          className={`
            relative
            mt-0.5
            flex
            h-10
            w-10
            shrink-0
            items-center
            justify-center
            rounded-xl
            transition-all
            duration-500
            ${
              t.visible
                ? "scale-100 rotate-0"
                : "scale-75 -rotate-12"
            }
          `}
          style={{
            backgroundColor: config.iconBg,
          }}
        >
          <Icon
            size={21}
            strokeWidth={1.8}
            style={{
              color: config.iconColor,
            }}
          />

          <span
            className="pointer-events-none absolute inset-0 rounded-xl opacity-30 blur-md"
            style={{
              backgroundColor: config.accent,
            }}
          />
        </div>

        {/* Message */}
        <div className="min-w-0 flex-1 pt-0.5">

          <div className="mb-1 flex items-center gap-2">
            <span
              className="text-[9px] font-semibold tracking-[0.22em]"
              style={{
                color: config.accent,
              }}
            >
              THOBEIAN
            </span>

            <span
              className="h-[3px] w-[3px] shrink-0 rounded-full"
              style={{
                backgroundColor: config.accent,
              }}
            />

            <span className="text-[9px] font-medium tracking-[0.16em] text-[#8B8B8B]">
              {title || config.label}
            </span>
          </div>

          <p className="break-words pr-1 text-[13px] font-medium leading-5 text-[#1F1F1F] sm:text-sm">
            {String(message ?? "")}
          </p>
        </div>

        {/* Close */}
        <button
          type="button"
          onClick={dismiss}
          aria-label="Close notification"
          className="
            flex
            h-7
            w-7
            shrink-0
            items-center
            justify-center
            rounded-full
            text-[#9A9A9A]
            transition-all
            duration-200
            hover:bg-[#F7F3EA]
            hover:text-[#1F1F1F]
            active:scale-90
          "
        >
          <X size={14} strokeWidth={1.8} />
        </button>
      </div>

      {/* Progress track */}
      <div className="h-[2px] w-full bg-[#F3F0EA]">
        <div
          className={`thobeian-toast-progress ${
            type === "error"
              ? "thobeian-toast-progress-error"
              : "thobeian-toast-progress-normal"
          } h-full origin-left`}
          style={{
            background: `
              linear-gradient(
                90deg,
                ${config.accent},
                ${config.accent}75
              )
            `,
          }}
        />
      </div>
    </div>
  );
}
