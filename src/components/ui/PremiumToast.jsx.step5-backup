"use client";

import {
  CheckCircle2,
  XCircle,
  AlertTriangle,
  Info,
  X,
} from "lucide-react";
import toast from "@/lib/toast";

const TOAST_CONFIG = {
  success: {
    icon: CheckCircle2,
    label: "SUCCESS",
    accent: "#C8A96B",
    iconBg: "rgba(200, 169, 107, 0.12)",
    iconColor: "#C8A96B",
  },

  error: {
    icon: XCircle,
    label: "ERROR",
    accent: "#B85C5C",
    iconBg: "rgba(184, 92, 92, 0.10)",
    iconColor: "#B85C5C",
  },

  warning: {
    icon: AlertTriangle,
    label: "WARNING",
    accent: "#C9963E",
    iconBg: "rgba(201, 150, 62, 0.10)",
    iconColor: "#C9963E",
  },

  info: {
    icon: Info,
    label: "NOTICE",
    accent: "#8D806D",
    iconBg: "rgba(141, 128, 109, 0.10)",
    iconColor: "#8D806D",
  },
};

export default function PremiumToast({
  t,
  type = "success",
  message,
  title,
}) {
  const config = TOAST_CONFIG[type] || TOAST_CONFIG.info;

  const Icon = config.icon;

  return (
    <div
      className={`
        relative
        w-full
        overflow-hidden
        rounded-2xl
        border
        bg-white/95
        backdrop-blur-xl
        shadow-[0_18px_55px_rgba(31,31,31,0.14)]
        transition-all
        duration-500
        ease-out
        ${
          t.visible
            ? "translate-y-0 scale-100 opacity-100"
            : "-translate-y-3 scale-[0.97] opacity-0"
        }
      `}
      style={{
        borderColor: `${config.accent}35`,
      }}
    >
      {/* =====================================================
          TOP ACCENT LINE
      ===================================================== */}
      <div
        className="absolute left-0 right-0 top-0 h-[2px]"
        style={{
          background: `linear-gradient(90deg, transparent, ${config.accent}, transparent)`,
        }}
      />

      {/* =====================================================
          MAIN CONTENT
      ===================================================== */}
      <div className="flex items-start gap-3.5 p-4 sm:p-4.5">

        {/* ===================================================
            ICON
        =================================================== */}
        <div
          className="relative mt-0.5 flex h-10 w-10 shrink-0 items-center justify-center rounded-xl"
          style={{
            backgroundColor: config.iconBg,
          }}
        >
          <Icon
            size={21}
            strokeWidth={1.8}
            style={{
              color: config.iconColor,
            }}
            className={`
              transition-transform
              duration-500
              ${
                t.visible
                  ? "scale-100 rotate-0"
                  : "scale-75 rotate-[-12deg]"
              }
            `}
          />

          {/* Soft glow */}
          <span
            className="pointer-events-none absolute inset-0 rounded-xl opacity-40 blur-md"
            style={{
              backgroundColor: config.accent,
            }}
          />
        </div>

        {/* ===================================================
            MESSAGE
        =================================================== */}
        <div className="min-w-0 flex-1 pt-0.5">

          <div className="mb-1 flex items-center gap-2">
            <span
              className="text-[9px] font-semibold tracking-[0.22em]"
              style={{
                color: config.accent,
              }}
            >
              THOBEIAN
            </span>

            <span className="h-[3px] w-[3px] rounded-full bg-[#D8C3A5]" />

            <span className="text-[9px] font-medium tracking-[0.16em] text-[#8B8B8B]">
              {title || config.label}
            </span>
          </div>

          <p className="break-words pr-1 text-[13px] font-medium leading-5 text-[#1F1F1F] sm:text-sm">
            {message}
          </p>

        </div>

        {/* ===================================================
            CLOSE
        =================================================== */}
        <button
          type="button"
          onClick={() => {
            toast.dismiss(t.id);
          }}
          className="
            flex
            h-7
            w-7
            shrink-0
            items-center
            justify-center
            rounded-full
            text-[#9A9A9A]
            transition-all
            duration-200
            hover:bg-[#F7F3EA]
            hover:text-[#1F1F1F]
            active:scale-90
          "
          aria-label="Close notification"
        >
          <X size={14} strokeWidth={1.8} />
        </button>

      </div>

      {/* =====================================================
          PROGRESS BAR
      ===================================================== */}
      <div className="h-[2px] w-full bg-[#F3F0EA]">
        <div
          className="h-full origin-left animate-[toastProgress_4.2s_linear_forwards]"
          style={{
            background: `linear-gradient(90deg, ${config.accent}, ${config.accent}70)`,
          }}
        />
      </div>

    </div>
  );
}
