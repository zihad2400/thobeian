"use client";

import {
  Check,
  X,
  AlertTriangle,
  Info,
  X as CloseIcon,
} from "lucide-react";
import hotToast from "react-hot-toast";

const CONFIG = {
  success: {
    icon: Check,
    accent: "#C8A96B",
    bg: "#FBF9F4",
    title: "Done",
    duration: 3200,
  },

  error: {
    icon: X,
    accent: "#B85C5C",
    bg: "#FCF7F7",
    title: "Oops",
    duration: 3800,
  },

  warning: {
    icon: AlertTriangle,
    accent: "#C9963E",
    bg: "#FCFAF5",
    title: "Notice",
    duration: 3400,
  },

  info: {
    icon: Info,
    accent: "#8D806D",
    bg: "#FAF9F6",
    title: "Info",
    duration: 3200,
  },
};

export default function PremiumToast({
  t,
  type = "success",
  message,
}) {
  const config = CONFIG[type] || CONFIG.info;
  const Icon = config.icon;

  return (
    <div
      role="status"
      aria-live="polite"
      className={`
        group
        relative
        flex
        w-auto
        max-w-[320px]
        items-center
        gap-2.5
        overflow-hidden
        rounded-full
        border
        bg-white
        px-3
        py-2.5
        transition-all
        duration-300
        ease-out
        sm:max-w-[350px]
        ${
          t.visible
            ? "translate-y-0 scale-100 opacity-100"
            : "translate-y-[-6px] scale-95 opacity-0"
        }
      `}
      style={{
        borderColor: `${config.accent}45`,
        backgroundColor: config.bg,
        boxShadow: "0 8px 28px rgba(31,31,31,0.12)",
      }}
    >
      {/* ICON */}
      <div
        className="
          flex
          h-7
          w-7
          shrink-0
          items-center
          justify-center
          rounded-full
        "
        style={{
          backgroundColor: `${config.accent}18`,
        }}
      >
        <Icon
          size={14}
          strokeWidth={2.4}
          style={{
            color: config.accent,
          }}
        />
      </div>

      {/* MESSAGE */}
      <div className="min-w-0 flex-1">
        <p className="truncate text-[12px] font-medium leading-4 text-[#252525] sm:text-[13px]">
          {message}
        </p>
      </div>

      {/* CLOSE */}
      <button
        type="button"
        onClick={() => hotToast.dismiss(t.id)}
        aria-label="Close notification"
        className="
          flex
          h-6
          w-6
          shrink-0
          items-center
          justify-center
          rounded-full
          text-[#A3A3A3]
          transition-all
          duration-200
          hover:bg-black/5
          hover:text-[#333]
          active:scale-90
        "
      >
        <CloseIcon
          size={12}
          strokeWidth={2}
        />
      </button>

      {/* MINI PROGRESS */}
      <div
        className="
          absolute
          bottom-0
          left-3
          right-3
          h-[1.5px]
          overflow-hidden
          rounded-full
          opacity-50
        "
        style={{
          backgroundColor: `${config.accent}20`,
        }}
      >
        <div
          className={
            type === "error"
              ? "h-full animate-[toastCompactError_3.8s_linear_forwards]"
              : "h-full animate-[toastCompact_3.2s_linear_forwards]"
          }
          style={{
            backgroundColor: config.accent,
          }}
        />
      </div>
    </div>
  );
}
